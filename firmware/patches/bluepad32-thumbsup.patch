+    switch_instance_t* ins = get_switch_instance(d);
+    if (ins->state == STATE_READY) {
+        uint32_t now = btstack_run_loop_get_time_ms();
+        if (now - ins->full_report_retry_ms >= 100) {
+            if (ins->full_report_retry_ms == 0) {
+                logi("Switch: still in report mode 0x3f, re-requesting 0x30\n");
+            }
+            ins->full_report_retry_ms = now;
+            send_set_full_report(d);
